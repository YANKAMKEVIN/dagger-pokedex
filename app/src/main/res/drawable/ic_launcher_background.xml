<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: a full-bleed Poké Ball. The launcher mask (circle,
     squircle, rounded square…) crops the outer edge, so the ball's features are
     drawn edge-to-edge and stay aligned regardless of mask shape. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- White base (becomes the bottom half of the ball). -->
    <path android:pathData="M0,0h108v108h-108z" android:fillColor="#F5F6F8" />
    <!-- Red top half. -->
    <path android:pathData="M0,0h108v54h-108z" android:fillColor="#DC0A2D" />
    <!-- Black central band. -->
    <path android:pathData="M0,49h108v10h-108z" android:fillColor="#0F1419" />
    <!-- Center button: black ring + white core. -->
    <path android:pathData="M54,36 a18,18 0 1,0 0,36 a18,18 0 1,0 0,-36 z"
        android:fillColor="#0F1419" />
    <path android:pathData="M54,42 a12,12 0 1,0 0,24 a12,12 0 1,0 0,-24 z"
        android:fillColor="#F5F6F8" />
</vector>
